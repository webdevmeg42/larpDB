# Database
DATABASE_URL=postgresql://larpdb:larpdb@localhost:5432/larpdb
TEST_DATABASE_URL=postgresql://larpdb:larpdb@localhost:5432/larpdb_test

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGIN=http://localhost:3000

# Server
PORT=3001
HOST=0.0.0.0

# Production sysadmin seed — set in Railway before running `node dist/db/seed-prod.js`
SYSADMIN_EMAIL=webdevmeg@gmail.com
SYSADMIN_PASSWORD=

# File storage — set STORAGE_PROVIDER=r2 and all R2_* vars in Railway for production
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sentry (API) — set in Railway; leave blank for local dev
SENTRY_DSN=

# Sentry (web) — set in Railway; leave blank for local dev
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
